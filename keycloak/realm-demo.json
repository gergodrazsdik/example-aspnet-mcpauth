{
  "realm": "demo",
  "displayName": "MCP Auth demo",
  "enabled": true,
  "attributes": {
    "note": "Dev-only demo realm: the users' passwords are public demo values. Never import it into a real Keycloak."
  },
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 604800,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "notes-reader", "description": "May read notes." },
      { "name": "notes-writer", "description": "May add notes." }
    ]
  },
  "users": [
    {
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Writer",
      "email": "alice@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["notes-reader", "notes-writer", "offline_access"]
    },
    {
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Reader",
      "email": "bob@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["notes-reader", "offline_access"]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "The user's ID (sub) in every token.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "profile",
      "description": "The user's username and name.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Your username and name"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": { "access.token.claim": "true", "id.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "roles",
      "description": "The user's realm roles, as a flat roles claim.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "offline_access",
      "description": "A refresh token that outlives the browser sign-in (an offline token). MCP clients ask for it.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Stay signed in (offline access)"
      }
    },
    {
      "name": "notes:read",
      "description": "Read the notes on the MCP server.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read your notes"
      },
      "protocolMappers": [
        {
          "name": "mcp audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "http://localhost:5100/mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "notes:write",
      "description": "Add notes on the MCP server.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Add notes for you"
      },
      "protocolMappers": [
        {
          "name": "mcp audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "http://localhost:5100/mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    { "clientScope": "notes:read", "roles": ["notes-reader"] },
    { "clientScope": "notes:write", "roles": ["notes-writer"] },
    { "clientScope": "offline_access", "roles": ["offline_access"] }
  ],
  "defaultDefaultClientScopes": ["basic", "profile", "roles"],
  "defaultOptionalClientScopes": ["notes:read", "notes:write", "offline_access"],
  "clientProfiles": {
    "profiles": [
      {
        "name": "require-pkce",
        "description": "Authorization code requests must carry a PKCE S256 code challenge.",
        "executors": [{ "executor": "pkce-enforcer", "configuration": { "auto-configure": "true" } }]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "public-clients-use-pkce",
        "description": "Every public client, including ones that registered themselves, must use PKCE S256.",
        "enabled": true,
        "conditions": [{ "condition": "client-access-type", "configuration": { "type": ["public"] } }],
        "profiles": ["require-pkce"]
      }
    ]
  },
  "components": {
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Trusted Hosts",
        "providerId": "trusted-hosts",
        "subType": "anonymous",
        "config": {
          "host-sending-registration-request-must-match": ["false"],
          "client-uris-must-match": ["true"],
          "trusted-hosts": ["localhost", "127.0.0.1"]
        }
      },
      { "name": "Consent Required", "providerId": "consent-required", "subType": "anonymous", "config": {} },
      { "name": "Full Scope Disabled", "providerId": "scope", "subType": "anonymous", "config": {} },
      { "name": "Max Clients Limit", "providerId": "max-clients", "subType": "anonymous", "config": { "max-clients": ["200"] } },
      { "name": "Allowed Client Scopes", "providerId": "allowed-client-templates", "subType": "anonymous", "config": { "allow-default-scopes": ["true"] } },
      { "name": "Allowed Protocol Mapper Types", "providerId": "allowed-protocol-mappers", "subType": "anonymous", "config": { "allowed-protocol-mapper-types": ["oidc-full-name-mapper", "oidc-sha256-pairwise-sub-mapper", "oidc-usermodel-attribute-mapper", "oidc-usermodel-property-mapper", "oidc-address-mapper", "saml-user-attribute-mapper", "saml-user-property-mapper", "saml-role-list-mapper"] } },
      { "name": "Allowed Registration Web Origins", "providerId": "registration-web-origins", "subType": "anonymous", "config": {} },
      { "name": "Allowed Client Scopes", "providerId": "allowed-client-templates", "subType": "authenticated", "config": { "allow-default-scopes": ["true"] } },
      { "name": "Allowed Protocol Mapper Types", "providerId": "allowed-protocol-mappers", "subType": "authenticated", "config": { "allowed-protocol-mapper-types": ["oidc-full-name-mapper", "oidc-sha256-pairwise-sub-mapper", "oidc-usermodel-attribute-mapper", "oidc-usermodel-property-mapper", "oidc-address-mapper", "saml-user-attribute-mapper", "saml-user-property-mapper", "saml-role-list-mapper"] } },
      { "name": "Allowed Registration Web Origins", "providerId": "registration-web-origins", "subType": "authenticated", "config": {} }
    ]
  },
  "clients": [
    {
      "clientId": "mcpauth-console",
      "name": "MCP Auth console client",
      "description": "The example's console client: a public client that signs in through the browser with PKCE and a loopback redirect.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "redirectUris": ["http://127.0.0.1/callback"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["basic", "profile", "roles"],
      "optionalClientScopes": ["notes:read", "notes:write", "offline_access"]
    },
    {
      "clientId": "mcpauth-vscode",
      "name": "Visual Studio Code",
      "description": "For VS Code, which registers with redirect URIs on vscode.dev that the registration policy refuses; enter this client ID when VS Code asks for one.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "redirectUris": ["http://127.0.0.1/", "https://vscode.dev/redirect"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["basic", "profile", "roles"],
      "optionalClientScopes": ["notes:read", "notes:write", "offline_access"]
    }
  ]
}
